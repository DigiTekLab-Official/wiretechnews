---
// src/pages/regulation/[slug].astro
import { getCollection, render } from 'astro:content';
import RegulationLayout from '../../layouts/RegulationLayout.astro';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const regulations = await getCollection('regulations');
  return regulations.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'regulations'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<RegulationLayout entry={entry}>
  <Content />
</RegulationLayout>
