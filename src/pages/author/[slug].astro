---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ui/ArticleCard.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { breadcrumbJsonLd } from '../../lib/jsonld';
import { absoluteUrl } from '../../lib/utils';
import { authorUrl } from '../../lib/utils';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((entry) => ({ params: { slug: entry.id }, props: { authorId: entry.id } }));
}

interface Props { authorId: string; }
const { authorId } = Astro.props;
const author = await getEntry('authors', authorId);
if (!author) return Astro.redirect('/');

const articles = await getCollection('articles', ({ data }) => data.author === authorId);
const sorted = articles.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const pageUrl = absoluteUrl(authorUrl(authorId));
---

<BaseLayout
  title={author.data.name}
  description={author.data.bio}
  canonicalUrl={pageUrl}
  jsonld={[
    {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: author.data.name,
      jobTitle: author.data.title,
      description: author.data.bio,
      url: pageUrl,
      ...(author.data.linkedin ? { sameAs: [author.data.linkedin] } : {}),
    },
    breadcrumbJsonLd([
      { name: 'Home', url: '/' },
      { name: author.data.name, url: authorUrl(authorId) },
    ]),
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb
      crumbs={[{ name: 'Home', url: '/' }, { name: author.data.name, url: authorUrl(authorId) }]}
    />

    <div class="mt-6 mb-10 flex items-start gap-5">
      {author.data.image && (
        <img
          src={author.data.image}
          alt={author.data.name}
          class="w-16 h-16 rounded-full object-cover shrink-0"
        />
      )}
      <div>
        <h1 class="text-2xl font-bold text-slate-900">{author.data.name}</h1>
        <p class="text-slate-500">{author.data.title}</p>
        {author.data.credentials && (
          <p class="mt-1 text-sm text-slate-500">{author.data.credentials.join(' · ')}</p>
        )}
        <p class="mt-3 text-slate-600">{author.data.bio}</p>
        {author.data.linkedin && (
          <a
            href={author.data.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-block text-sm text-blue-600 hover:text-blue-700"
          >
            LinkedIn →
          </a>
        )}
      </div>
    </div>

    {sorted.length > 0 && (
      <section>
        <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-5">
          Published Work
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {sorted.map((article) => <ArticleCard entry={article} />)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
