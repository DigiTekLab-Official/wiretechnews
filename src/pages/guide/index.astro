---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ui/ArticleCard.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles', ({ data }) => data.contentType === 'guide');
const sorted = articles.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  title="Compliance Guides"
  description="Practical compliance guides for GDPR, EU AI Act, NIS2, DORA, and other regulations — step-by-step guidance for compliance professionals and legal teams."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb crumbs={[{ name: 'Home', url: '/' }, { name: 'Guides', url: '/guide/' }]} />
    <h1 class="mt-6 text-3xl font-bold text-slate-900 mb-8">Compliance Guides</h1>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sorted.map((article) => <ArticleCard entry={article} />)}
    </div>
  </div>
</BaseLayout>
