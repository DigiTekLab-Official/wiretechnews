---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ui/ArticleCard.astro';
import RegulationCard from '../../components/ui/RegulationCard.astro';
import GlossaryCard from '../../components/ui/GlossaryCard.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { TOPICS, TOPIC_SLUGS } from '../../lib/topics';
import { breadcrumbJsonLd } from '../../lib/jsonld';
import { topicUrl } from '../../lib/utils';
import type { TopicSlug } from '../../lib/topics';

export async function getStaticPaths() {
  return TOPIC_SLUGS.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: TopicSlug };
const topic = TOPICS[slug];

const [articles, regulations, glossaryEntries] = await Promise.all([
  getCollection('articles', ({ data }) => data.topic === slug),
  getCollection('regulations'),
  getCollection('glossary', ({ data }) => data.topic === slug),
]);

const sortedArticles = articles.sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

// Regulations referenced by articles in this topic
const referencedSlugs = new Set(sortedArticles.flatMap((a) => a.data.regulations));
const topicRegulations = regulations.filter((r) => referencedSlugs.has(r.slug));

const featured = sortedArticles.filter((a) => a.data.featured);
const rest = sortedArticles.filter((a) => !a.data.featured);
---

<BaseLayout
  title={`${topic.label} Intelligence`}
  description={topic.description}
  jsonld={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: `${topic.label} — WireTechNews`,
      description: topic.description,
      url: `https://wiretechnews.com${topicUrl(slug)}`,
    },
    breadcrumbJsonLd([
      { name: 'Home', url: '/' },
      { name: topic.label, url: topicUrl(slug) },
    ]),
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb
      crumbs={[{ name: 'Home', url: '/' }, { name: topic.label, url: topicUrl(slug) }]}
    />

    <div class="mt-6 mb-10 max-w-2xl">
      <h1 class="text-3xl font-bold text-slate-900">{topic.label}</h1>
      <p class="mt-3 text-slate-600 leading-relaxed">{topic.description}</p>
    </div>

    <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12">
      <div>
        {featured.length > 0 && (
          <section class="mb-10">
            <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-4">Featured</h2>
            <div class="border border-slate-200 rounded-xl p-6">
              <ArticleCard entry={featured[0]} featured />
            </div>
          </section>
        )}

        {rest.length > 0 && (
          <section>
            <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-4">
              {featured.length > 0 ? 'More' : 'All'} Intelligence
            </h2>
            <div class="grid sm:grid-cols-2 gap-6">
              {rest.map((article) => <ArticleCard entry={article} />)}
            </div>
          </section>
        )}

        {sortedArticles.length === 0 && (
          <p class="text-slate-500">No articles published in this topic yet.</p>
        )}
      </div>

      <aside class="mt-12 lg:mt-0 space-y-8">
        {topicRegulations.length > 0 && (
          <div>
            <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-3">
              Key Regulations
            </h2>
            <ul class="space-y-3">
              {topicRegulations.map((reg) => (
                <li><RegulationCard entry={reg} compact /></li>
              ))}
            </ul>
          </div>
        )}

        {glossaryEntries.length > 0 && (
          <div>
            <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-3">
              Key Terms
            </h2>
            <ul class="space-y-3">
              {glossaryEntries.map((entry) => (
                <li><GlossaryCard entry={entry} /></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>
