---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Search from 'astro-pagefind/components/Search';
---

<BaseLayout
  title="Search"
  description="Search regulations, intelligence briefings, compliance guides, glossary terms, and analysis across WireTechNews."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-2xl font-bold text-slate-900 mb-8">Search</h1>
    <Search
      id="search"
      className="pagefind-search"
      uiOptions={{ showImages: false, resetStyles: false }}
    />
  </div>
</BaseLayout>
