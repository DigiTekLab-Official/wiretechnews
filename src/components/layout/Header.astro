---
// src/components/layout/Header.astro
import { TOPICS, TOPIC_SLUGS } from '../../lib/topics';

const currentPath = Astro.url.pathname;
---

<header class="border-b border-slate-200 bg-white sticky top-0 z-40">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      <a href="/" class="font-bold text-slate-900 tracking-tight text-lg shrink-0">
        WireTechNews
      </a>

      <div class="hidden lg:flex items-center gap-5 text-sm font-medium text-slate-600">
        {TOPIC_SLUGS.map((slug) => (
          <a
            href={`/topic/${slug}/`}
            class:list={[
              'hover:text-slate-900 transition-colors',
              currentPath.startsWith(`/topic/${slug}`) && 'text-slate-900',
            ]}
          >
            {TOPICS[slug].label}
          </a>
        ))}
        <span class="text-slate-300">|</span>
        <a href="/regulation/" class="hover:text-slate-900 transition-colors">Regulations</a>
        <a href="/glossary/" class="hover:text-slate-900 transition-colors">Glossary</a>
        <a href="/search/" class="hover:text-slate-900 transition-colors">Search</a>
      </div>

      <a
        href="/newsletter/"
        class="shrink-0 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-1.5 rounded transition-colors"
      >
        Newsletter
      </a>
    </div>
  </nav>
</header>