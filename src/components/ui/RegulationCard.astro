---
import StatusBadge from './StatusBadge.astro';
import { regulationUrl } from '../../lib/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'regulations'>;
  compact?: boolean;
}

const { entry, compact = false } = Astro.props;
const { name, shortName, type, status, jurisdictions } = entry.data;
const url = regulationUrl(entry.slug);
---

{compact ? (
  <a
    href={url}
    class="flex items-start gap-2 group text-sm"
  >
    <span class="font-semibold text-blue-600 group-hover:text-blue-700 shrink-0">{shortName}</span>
    <span class="text-slate-500 line-clamp-1">{name}</span>
  </a>
) : (
  <article class="border border-slate-200 rounded-lg p-5 hover:border-slate-300 transition-colors group">
    <a href={url} class="block">
      <div class="flex items-start justify-between gap-2">
        <div>
          <p class="font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
            {shortName}
          </p>
          <p class="text-sm text-slate-600 mt-0.5">{name}</p>
        </div>
        <StatusBadge status={status} />
      </div>
      <div class="mt-3 flex items-center gap-2 flex-wrap">
        <span class="text-xs text-slate-500 capitalize">{type}</span>
        {jurisdictions.slice(0, 3).map((j) => (
          <span class="text-xs bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded">{j}</span>
        ))}
      </div>
    </a>
  </article>
)}
