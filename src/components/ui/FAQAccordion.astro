---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<div class="space-y-4">
  {
    items.map((item, index) => (
      <details class="group rounded-xl border border-zinc-200 bg-white p-5 shadow-sm transition-all duration-200 open:border-zinc-300 open:shadow-md">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-zinc-900 marker:hidden">
          <span>{item.question}</span>

          <span class="relative flex h-6 w-6 items-center justify-center rounded-full border border-zinc-300 text-zinc-600 transition-transform duration-200">
            <span class="absolute text-lg leading-none transition-opacity duration-200 group-open:opacity-0">
              +
            </span>

            <span class="absolute text-xl leading-none opacity-0 transition-opacity duration-200 group-open:opacity-100">
              −
            </span>
          </span>
        </summary>

        <div class="pt-4 text-[15px] leading-7 text-zinc-700">
          <p>{item.answer}</p>
        </div>
      </details>
    ))
  }
</div>